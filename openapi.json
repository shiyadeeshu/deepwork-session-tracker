{
  "openapi": "3.1.0",
  "info": {
    "title": "Deep Work Session Tracker API",
    "description": "Plan, start, pause, resume and complete focused work sessions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/sessions/": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List all sessions (newest first)",
        "operationId": "list_sessions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionRead"
                  },
                  "type": "array",
                  "title": "Response List Sessions"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Schedule a new work session",
        "operationId": "create_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/history": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Summary of past sessions: durations, pauses, completion ratio",
        "operationId": "get_session_history",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistorySummary"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get one session",
        "operationId": "get_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/start": {
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Start a scheduled session",
        "operationId": "start_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Action not allowed in the current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/pause": {
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Pause an active session and log the interruption reason",
        "description": "Only active sessions can be paused. The 4th pause marks the session `interrupted`.",
        "operationId": "pause_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Action not allowed in the current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/resume": {
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Resume a paused session",
        "operationId": "resume_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Action not allowed in the current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/complete": {
      "patch": {
        "tags": [
          "sessions"
        ],
        "summary": "Complete a session (stores completion time)",
        "description": "Active \u2192 `completed` if finished within scheduled duration + 10%, else `overdue`. Paused (never resumed) \u2192 `abandoned`.",
        "operationId": "complete_session",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRead"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Action not allowed in the current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistorySummary": {
        "properties": {
          "total_sessions": {
            "type": "integer",
            "title": "Total Sessions",
            "description": "All sessions, any status"
          },
          "finished_sessions": {
            "type": "integer",
            "title": "Finished Sessions",
            "description": "Sessions in a final state"
          },
          "status_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/SessionStatus"
            },
            "type": "object",
            "title": "Status Counts"
          },
          "completion_ratio": {
            "type": "number",
            "title": "Completion Ratio",
            "description": "completed / finished sessions (0.0 when nothing has finished)"
          },
          "total_pauses": {
            "type": "integer",
            "title": "Total Pauses"
          },
          "average_pauses_per_session": {
            "type": "number",
            "title": "Average Pauses Per Session"
          },
          "total_focus_minutes": {
            "type": "number",
            "title": "Total Focus Minutes",
            "description": "Sum of actual durations of finished sessions"
          },
          "average_duration_minutes": {
            "type": "number",
            "title": "Average Duration Minutes"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionHistoryItem"
            },
            "type": "array",
            "title": "Sessions",
            "description": "Finished sessions, newest first"
          }
        },
        "type": "object",
        "required": [
          "total_sessions",
          "finished_sessions",
          "status_counts",
          "completion_ratio",
          "total_pauses",
          "average_pauses_per_session",
          "total_focus_minutes",
          "average_duration_minutes",
          "sessions"
        ],
        "title": "HistorySummary"
      },
      "InterruptionRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "pause_time": {
            "type": "string",
            "format": "date-time",
            "title": "Pause Time"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reason",
          "pause_time"
        ],
        "title": "InterruptionRead"
      },
      "PauseRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "examples": [
              "Phone call"
            ]
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "PauseRequest"
      },
      "SessionCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Write report intro"
            ]
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal",
            "examples": [
              "Finish the first draft"
            ]
          },
          "scheduled_duration": {
            "type": "integer",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Scheduled Duration",
            "description": "Planned length in minutes",
            "examples": [
              50
            ]
          }
        },
        "type": "object",
        "required": [
          "title",
          "scheduled_duration"
        ],
        "title": "SessionCreate"
      },
      "SessionHistoryItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "scheduled_duration": {
            "type": "integer",
            "title": "Scheduled Duration",
            "description": "Planned length in minutes"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "pause_count": {
            "type": "integer",
            "title": "Pause Count"
          },
          "interruptions": {
            "items": {
              "$ref": "#/components/schemas/InterruptionRead"
            },
            "type": "array",
            "title": "Interruptions"
          },
          "actual_duration_minutes": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Duration Minutes",
            "description": "Wall-clock minutes from start to end (pauses included)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "scheduled_duration",
          "start_time",
          "end_time",
          "status",
          "created_at",
          "pause_count",
          "interruptions",
          "actual_duration_minutes"
        ],
        "title": "SessionHistoryItem"
      },
      "SessionRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "scheduled_duration": {
            "type": "integer",
            "title": "Scheduled Duration",
            "description": "Planned length in minutes"
          },
          "start_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "pause_count": {
            "type": "integer",
            "title": "Pause Count"
          },
          "interruptions": {
            "items": {
              "$ref": "#/components/schemas/InterruptionRead"
            },
            "type": "array",
            "title": "Interruptions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "scheduled_duration",
          "start_time",
          "end_time",
          "status",
          "created_at",
          "pause_count",
          "interruptions"
        ],
        "title": "SessionRead"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "scheduled",
          "active",
          "paused",
          "completed",
          "interrupted",
          "abandoned",
          "overdue"
        ],
        "title": "SessionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
